# Database
DATABASE_URL=

# Bank transfer payment
# MercadoLibre alias shown on the reservation page. When empty, the page falls
# back to neutral copy instead of the alias.
PAYMENT_ALIAS=

# Supabase Storage (server-side only)
# The receipts bucket is PRIVATE and is served through expiring signed URLs, so
# the browser never talks to Supabase directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel access (single user)
ADMIN_USER=admin
# Generate the hash with: node scripts/hash-admin-password.mjs "your-password"
# Format: scrypt$<saltHex>$<hashHex>
ADMIN_PASSWORD_HASH=scrypt$REPLACE$WITH_GENERATED_HASH
# Random string used to sign the admin session cookie. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string
# The session cookie is marked `Secure` automatically when NODE_ENV is
# `production`. Do not set NODE_ENV yourself; Next and the host already do.
